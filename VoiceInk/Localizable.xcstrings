    "Vocabulary helps supported transcription models and AI enhancement preserve important names, technical terms, and unique spellings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vokabular hilft unterstützten Transkriptionsmodellen und der KI-Verbesserung, wichtige Namen, Fachbegriffe und besondere Schreibweisen beizubehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vocabulaire aide les modèles de transcription pris en charge et l'amélioration de l'IA à préserver les noms importants, les termes techniques et les orthographes uniques."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词汇可帮助受支持的转写模型和 AI 润色保留重要的人名、专业术语和特殊拼写。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Словарь помогает моделям точнее распознавать имена, фамилии, бренды и спецтермины."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Словник допомагає точніше розпізнавати імена, технічні терміни та назви."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slovní zásoba pomáhá modelům přesně přepisovat jména a odborné výrazy."
          }
        }
      }
    },
