    "This can happen due to an issue with the audio recording or insufficient system resources. Please try again, or restart the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann durch ein Problem mit der Audioaufnahme oder durch unzureichende Systemressourcen auftreten. Bitte versuche es erneut oder starte die App neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut se produire en raison d'un problème avec l'enregistrement audio ou de ressources système insuffisantes. Veuillez réessayer ou redémarrer l'application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能是由录音问题或系统资源不足导致的。请重试，或重新启动 App。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может быть вызвано сбоем аудио или нехваткой ресурсов. Попробуйте снова или перезапустите приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це може статися через збій аудіо або нестачу ресурсів."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K tomu může dojít kvůli potížím s nahráváním zvuku nebo nedostatku systémových prostředků."
          }
        }
      }
    },
    "This deactivates VoiceInk on this Mac and frees a device on your license.": {
      "comment": "A message displayed in a confirmation dialog when the user deactivates their license.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird VoiceInk auf diesem Mac deaktiviert und ein Geräteplatz in deiner Lizenz freigegeben."
          }
        },
        "en": {
