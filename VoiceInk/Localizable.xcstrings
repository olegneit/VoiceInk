    "Offers word replacements on your Mac. Add a suggestion to keep it, or dismiss it.": {
      "comment": "Explains local Auto Learn suggestions in the information tip.",
      "extractionState": "manual",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt Wortersetzungen auf deinem Mac vor. Füge einen Vorschlag hinzu, um ihn zu speichern, oder verwerfe ihn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propose des remplacements de mots sur votre Mac. Ajoutez une suggestion pour la conserver, ou ignorez-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上提供词语替换建议。添加建议以保存，或将其忽略。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагает автозамены слов на вашем Mac. Добавьте подсказку, чтобы сохранить её, или отклоните."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонує автозаміни слів на вашому Mac. Додайте пропозицію, щоб зберегти її, або відхиліть."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabízí nahrazování slov na vašem Macu. Přidejte návrh pro uložení nebo jej odmítněte."
          }
        }
      }
    },
