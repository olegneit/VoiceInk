    "Remote typing could not start. Check Accessibility access and keyboard layout.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Desktop-Texteingabe konnte nicht gestartet werden. Prüfe den Bedienungshilfen-Zugriff und das Tastaturlayout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la saisie à distance. Vérifiez l’autorisation d’accessibilité et la disposition du clavier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始远程输入。请检查辅助功能权限和键盘布局。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить ввод на удаленном столе. Проверьте универсальный доступ и раскладку клавиатуры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити введення у віддаленому столі. Перевірте доступність та розкладку клавіатури."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálené psaní se nepodařilo spustit. Zkontrolujte přístupnost a rozložení klávesnice."
          }
        }
      }
    },
    "Remote typing was interrupted. Check the destination before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Desktop-Texteingabe wurde unterbrochen. Prüfe den Text im Zielprogramm, bevor du es erneut versuchst."
