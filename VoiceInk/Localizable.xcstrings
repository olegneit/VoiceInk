    "'%@' is the default mode. Set another mode as default before deleting it.": {
      "comment": "A warning alert that appears when the user tries to delete a mode that is set as the default mode. The argument is the name of the mode.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist der Standardmodus. Lege vor dem Löschen einen anderen Modus als Standard fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est le mode par défaut. Définissez un autre mode par défaut avant de le supprimer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是默认模式。请先将其他模式设为默认模式，然后再删除它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — это режим по умолчанию. Перед удалением установите другой режим по умолчанию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' є режимом за умовчанням. Перед видаленням установіть інший режим за замовчуванням."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí režim je „%@“. Před odstraněním nastavte jako výchozí jiný režim."
          }
        }
      }
    },
