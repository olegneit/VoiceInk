    "Custom prompts aren't available with VoiceInk Refine. Select a Mode that uses another AI provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Prompts sind mit VoiceInk Refine nicht verfügbar. Wähle einen Modus mit einem anderen KI-Anbieter."
