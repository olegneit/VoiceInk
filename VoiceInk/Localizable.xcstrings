    "Merge": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusionner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об'єднати"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučit"
          }
        }
      }
    },
    "Merge adds new entries while keeping the current dictionary and skips duplicates or conflicts. Replace removes the current vocabulary and word replacements before importing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführen fügt neue Einträge hinzu, behält das aktuelle Wörterbuch bei und überspringt Duplikate oder Konflikte. Ersetzen entfernt vor dem Import das aktuelle Vokabular und die Wortersetzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion ajoute de nouvelles entrées tout en conservant le dictionnaire actuel et ignore les doublons ou les conflits. Remplacer supprime le vocabulaire actuel et les remplacements de mots avant l'importation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“合并”会在保留当前词典的同时添加新条目，并跳过重复项或冲突项。“替换”会在导入前移除当前词汇和词语替换。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Объединить» добавит новые записи, сохранит текущий словарь и пропустит дубликаты. «Заменить» удалит все текущие слова и замены перед импортом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Об'єднати» додасть нові записи, зберігши поточний словник і пропустивши дублікати. «Замінити» видалить усі наявні слова та заміни перед імпортом."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sloučit» přidá nové položky, zachová stávající slovník a přeskočí duplicity. «Nahradit» před importem vymaže stávající slovník a pravidla nahrazování."
          }
        }
      }
    },
