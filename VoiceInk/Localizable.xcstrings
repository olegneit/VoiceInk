    "Repair backs up damaged Auto-Learn data and resets it. Saved dictionary entries are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Reparatur werden beschädigte Auto-Learn-Daten gesichert und zurückgesetzt. Gespeicherte Wörterbucheinträge bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réparation sauvegarde les données d’apprentissage automatique endommagées, puis les réinitialise. Les entrées du dictionnaire sont conservées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复会备份并重置损坏的自动学习数据。已保存的词典条目将会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление создаст резервную копию поврежденных данных автообучения и сбросит их. Сохраненные записи словаря останутся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення створить резервну копію пошкоджених даних автонавчання та скине їх. Збережені записи словника залишаться."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprava zálohuje poškozená data automatického učení a resetuje je. Uložené položky slovníku zůstanou zachovány."
          }
        }
      }
    },
    "Repair backs up damaged Auto-Learn data and resets it. Saved dictionary entries are kept. Previously dismissed suggestions may appear again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Reparatur werden beschädigte Auto-Learn-Daten gesichert und zurückgesetzt. Gespeicherte Wörterbucheinträge bleiben erhalten. Zuvor verworfene Vorschläge können erneut erscheinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réparation sauvegarde les données d’apprentissage automatique endommagées, puis les réinitialise. Les entrées du dictionnaire sont conservées. Des suggestions ignorées auparavant peuvent réapparaître."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修复会备份并重置损坏的自动学习数据。已保存的词典条目将会保留。之前忽略的建议可能会再次出现。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление создаст резервную копию поврежденных данных автообучения и сбросит их. Сохраненные записи останутся. Ранее отклоненные подсказки могут появиться снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення створить резервну копію даних автонавчання та скине їх. Записи словника збережуться. Раніше відхилені підказки можуть з'явитися знову."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprava zálohuje poškozená data automatického učení a resetuje je. Uložené položky slovníku zůstanou zachovány. Dříve odmítnuté návrhy se mohou znovu objevit."
          }
        }
      }
    },
