    "Only local Whisper models use this. Add example text to guide spelling and style.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lokale Whisper-Modelle verwenden dies. Beispieltext steuert Schreibweise und Stil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les modèles Whisper locaux l’utilisent. Ajoutez un exemple de texte pour guider l’orthographe et le style."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本地 Whisper 模型使用此内容。示例文本可引导拼写和风格。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется только локальными моделями Whisper. Добавьте пример текста, чтобы задать стиль и термины."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується лише локальними моделями Whisper. Додайте приклад тексту для правильного правопису та стилю."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používají pouze místní modely Whisper. Přidejte ukázkový text pro správný pravopis a styl."
